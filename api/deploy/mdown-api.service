[Unit]
Description=mdown media download API (Go)
Documentation=https://mdown.cc
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=mdown
Group=mdown
WorkingDirectory=/var/lib/mdown
EnvironmentFile=/etc/mdown/api.env
# yt-dlp lives in the venv; ffmpeg and ffprobe come from apt
Environment=PATH=/opt/mdown/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# a 1 GB box: let the Go runtime return memory before the cgroup limit bites
Environment=GOMEMLIMIT=384MiB
ExecStart=/opt/mdown/bin/mdown-api

Restart=always
RestartSec=2
TimeoutStopSec=20
KillMode=control-group

# --- isolation ------------------------------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
ReadWritePaths=/var/lib/mdown

# --- resource ceilings ----------------------------------------------------
MemoryMax=1536M
CPUQuota=180%
TasksMax=256

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mdown-api

[Install]
WantedBy=multi-user.target
