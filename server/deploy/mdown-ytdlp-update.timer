[Unit]
Description=yt-dlp update for mdown, every six hours

[Timer]
# a site that changed this morning should work again this afternoon. a run
# with nothing new costs one pip check and touches nothing.
OnCalendar=*-*-* 00/6:00:00
RandomizedDelaySec=30m
Persistent=true

[Install]
WantedBy=timers.target
